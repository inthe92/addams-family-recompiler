option(NES_ENABLE_MODS "Build the native Lua mod engine" ON)
option(NES_ENABLE_DESKTOP "Build SDL2/OpenGL desktop frontend" ON)

set(NES_DEPENDENCY_DIR "${CMAKE_CURRENT_SOURCE_DIR}/third_party")
if(EXISTS "${NES_DEPENDENCY_DIR}/SDL2-2.32.8.tar.gz")
  set(NES_DEPENDENCY_DIR "${CMAKE_CURRENT_BINARY_DIR}/_deps")
  file(MAKE_DIRECTORY "${NES_DEPENDENCY_DIR}")
  foreach(entry "SDL2-2.32.8|0ca83e9c9b31e18288c7ec811108e58bac1f1bb5ec6577ad386830eac51c787e" "lua-5.5.1|1c4b4068d67061f2a2231ad2b5422e77acea1487ea9890f6320af614f4373dce")
    string(REPLACE "|" ";" fields "${entry}")
    list(GET fields 0 name)
    list(GET fields 1 expected)
    set(archive "${CMAKE_CURRENT_SOURCE_DIR}/third_party/${name}.tar.gz")
    file(SHA256 "${archive}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Bundled dependency checksum differs: ${name}")
    endif()
    if(NOT EXISTS "${NES_DEPENDENCY_DIR}/${name}/CMakeLists.txt" AND NOT EXISTS "${NES_DEPENDENCY_DIR}/${name}/src/lua.h")
      file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${NES_DEPENDENCY_DIR}")
    endif()
  endforeach()
endif()

# Sources are kept locally; an ordinary build needs no network access.
# Official URLs/checksums are recorded in third_party/manifest.json.
if(NES_ENABLE_MODS)
  set(lua_source "${NES_DEPENDENCY_DIR}/lua-5.5.1/src")
  file(GLOB lua_sources CONFIGURE_DEPENDS "${lua_source}/*.c")
  list(REMOVE_ITEM lua_sources "${lua_source}/lua.c" "${lua_source}/luac.c")
  if(NOT EXISTS "${lua_source}/lua.h")
    message(FATAL_ERROR "Local Lua sources missing; see third_party/manifest.json")
  endif()
  add_library(lua_embedded STATIC ${lua_sources})
  target_include_directories(lua_embedded PUBLIC "${lua_source}")
  set_target_properties(lua_embedded PROPERTIES C_STANDARD 99 C_STANDARD_REQUIRED ON)
  if(UNIX)
    target_link_libraries(lua_embedded PRIVATE m ${CMAKE_DL_LIBS})
  endif()
endif()

if(NES_ENABLE_DESKTOP)
  set(SDL_SHARED OFF CACHE BOOL "" FORCE)
  set(SDL_STATIC ON CACHE BOOL "" FORCE)
  set(SDL_TEST OFF CACHE BOOL "" FORCE)
  set(SDL_TESTS OFF CACHE BOOL "" FORCE)
  set(SDL_INSTALL OFF CACHE BOOL "" FORCE)
  add_subdirectory("${NES_DEPENDENCY_DIR}/SDL2-2.32.8" "${CMAKE_CURRENT_BINARY_DIR}/sdl2" EXCLUDE_FROM_ALL)
  find_package(OpenGL REQUIRED)
endif()
